{
  "expo": {
    "name": "TeleCare Pro",
    "slug": "telecare-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "telecare",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "bundleIdentifier": "com.murmu.telecare",
      "infoPlist": {
        "NSCameraUsageDescription": "TeleCare needs camera access for video consultations.",
        "NSMicrophoneUsageDescription": "TeleCare needs microphone access for video consultations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.murmu.telecare",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "TeleCare Pro",
      "shortName": "TeleCare",
      "description": "Online doctor consultations, prescriptions & health records",
      "themeColor": "#2563EB",
      "backgroundColor": "#0F172A",
      "lang": "en",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "androidMode": "default",
          "androidCollapsedTitle": "Incoming Call"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TeleCare to access your camera for video consultations.",
          "microphonePermission": "Allow TeleCare to access your microphone for video consultations."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
